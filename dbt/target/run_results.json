t(replace(trim(valor_venda), ',', '.') as decimal(10, 4))     as valor_venda,\n        case\n            when trim(unidade_medida) = 'R$ / litro' then 'R$/litro'\n            when trim(unidade_medida) in ('R$ / m\u00b3', 'R$ / m3') then 'R$/m3'\n            else trim(unidade_medida)\n        end                                                                  as unidade_medida,\n        case\n            when upper(trim(bandeira)) = 'VIBRA ENERGIA' then 'VIBRA'\n            else upper(trim(bandeira))\n        end                                                                  as bandeira,\n        trim(revenda)                                                        as revenda,\n        upper(trim(regiao_sigla))                                            as regiao_sigla,\n        upper(trim(estado_sigla))                                            as uf,\n        upper(trim(municipio))                                               as municipio,\n        trim(bairro)                                                         as bairro,\n        trim(cep)                                                            as cep,\n        _source_group                                                        as source_group,\n        case _source_group\n            when 'mensal' then 1\n            when 'semestral' then 2\n            when 'ultimas_4_semanas' then 3\n            else 9\n        end                                                                  as source_priority\n    from source\n\n),\n\nranked as (\n\n    select\n        *,\n        min(source_priority) over (\n            partition by cnpj_revenda, produto, data_coleta\n        ) as best_priority\n    from typed\n\n),\n\nbest as (\n\n    select * from ranked where source_priority = best_priority\n\n)\n\nselect\n    cnpj_revenda,\n    produto,\n    data_coleta,\n    round(avg(valor_venda), 4)::decimal(10, 4)  as valor_venda,\n    min(unidade_medida)                         as unidade_medida,\n    min(bandeira)                               as bandeira,\n    min(revenda)                                as revenda,\n    min(regiao_sigla)                           as regiao_sigla,\n    min(uf)                                     as uf,\n    min(municipio)                              as municipio,\n    min(bairro)                                 as bairro,\n    min(cep)                                    as cep,\n    min(source_group)                           as source_group,\n    count(*)                                    as n_registros_origem\nfrom best\ngroup by cnpj_revenda, produto, data_coleta", "relation_name": "\"observatorio\".\"staging\".\"stg_anp_precos\"", "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-10-13T02:49:19.731701Z", "completed_at": "2026-10-13T02:49:19.751872Z"}, {"name": "execute", "started_at": "2026-10-13T02:49:19.752437Z", "completed_at": "2026-10-13T02:49:19.798063Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.0765380859375, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.observatorio.assert_anp_cnpj_has_14_digits", "compiled": true, "compiled_code": "select * from \"observatorio\".\"staging\".\"stg_anp_precos\" where length(cnpj_revenda) <> 14", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-10-13T02:49:19.815129Z", "completed_at": "2026-10-13T02:49:19.817842Z"}, {"name": "execute", "started_at": "2026-10-13T02:49:19.818305Z", "completed_at": "2026-10-13T02:49:19.827862Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.014929771423339844, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.observatorio.assert_anp_price_in_plausible_range", "compiled": true, "compiled_code": "-- Sanity bounds (R$ per litre / m3): catches shifted decimals or parsing errors.\nselect * from \"observ